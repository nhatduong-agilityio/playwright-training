    "@typescript-eslint/parser": "^8.34.1",
    "dotenv": "^17.2.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-visual-complexity": "^0.1.4",
    "globals": "^16.3.0",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "otpauth": "^9.4.0",
